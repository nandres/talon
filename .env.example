# Supabase (los valores locales los imprime `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo del lado del servidor: webhook de pagos y cron de recordatorios
SUPABASE_SECRET_KEY=
# Firma de los avisos de la pasarela de pagos (cualquier texto largo y aleatorio)
PAGOS_SECRETO=
# Lo manda Vercel Cron como "Authorization: Bearer ..." al proceso de mensajes
CRON_SECRET=
